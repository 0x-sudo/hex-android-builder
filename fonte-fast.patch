+    /** [total] bytes as [PARTS] range requests at once, written positionally into [to], then hashed. */
+    private suspend fun downloadParts(
+        url: String,
+        to: File,
+        total: Long,
+        headers: Map<String, String>,
+        progress: (done: Long, total: Long) -> Unit,
+    ): Download = coroutineScope {
+        val parts = minOf(PARTS.toLong(), (total + PART_MIN - 1) / PART_MIN).toInt().coerceAtLeast(1)
+        val size = (total + parts - 1) / parts
+        val done = AtomicLong(0)
+        val last = AtomicLong(System.nanoTime())
+        val lock = Any()
+        FileChannel.open(to.toPath(), StandardOpenOption.CREATE, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING).use { out ->
+            val watchdog = launch {
+                while (true) {
+                    delay(STALL_MS / 4)
+                    if (System.nanoTime() - last.get() > STALL_MS * 1_000_000) throw IOException("Download stalled")
+                }
+            }
+            try {
+                (0 until parts).map { i ->
+                    val start = i * size
+                    val end = minOf(total - 1, start + size - 1)
+                    async(Dispatchers.IO) {
+                        var pos = start
+                        exchange(
+                            url,
+                            headers + ("Range" to "bytes=$start-$end"),
+                            onStart = { info ->
+                                if (info.httpStatusCode != 206) throw IOException("Server answered HTTP ${info.httpStatusCode}")
+                            },
+                        ) { buf ->
+                            val n = buf.remaining()
+                            if (pos + n > end + 1) throw IOException("Too much data")
+                            var p = pos
+                            while (buf.hasRemaining()) p += out.write(buf, p)
+                            pos += n
+                            last.set(System.nanoTime())
+                            val now = done.addAndGet(n.toLong())
+                            synchronized(lock) { progress(now, total) }
+                        }
+                        if (pos != end + 1) throw IOException("Download incomplete")
+                    }
+                }.awaitAll()
+            } finally {
+                watchdog.cancel()
+            }
+        }
+        if (to.length() != total) throw IOException("Download incomplete")
+        val digest = MessageDigest.getInstance("SHA-256")
+        to.inputStream().use { input ->
+            val buf = ByteArray(1 shl 20)
+            while (true) {
+                val n = input.read(buf)
+                if (n < 0) break
+                digest.update(buf, 0, n)
+            }
+        }
+        Log.d(TAG, "Downloaded $total bytes from ${URI(url).host} in $parts parts")
+        Download(total, digest.digest().toHex())
+    }
