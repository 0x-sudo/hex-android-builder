+/**
+ * The Azure origin in a Fastly-signed GitHub asset URL, or null when [url] is not one. GitHub puts the origin host
+ * in the JWT's `path` claim; the SAS signature covers the blob, not the host, so the same URL works there.
+ */
+private fun directOrigin(url: String): String? {
+    val uri = runCatching { Uri.parse(url) }.getOrNull() ?: return null
+    if (uri.host != "release-assets.githubusercontent.com") return null
+    val jwt = uri.getQueryParameter("jwt") ?: return null
+    val payload = jwt.split('.').getOrNull(1) ?: return null
+    val json = runCatching {
+        String(Base64.decode(payload, Base64.URL_SAFE or Base64.NO_WRAP or Base64.NO_PADDING))
+    }.getOrNull() ?: return null
+    val host = runCatching { JSONObject(json).optString("path") }.getOrNull()
+        ?.takeIf { it.endsWith(".blob.core.windows.net") } ?: return null
+    val query = uri.encodedQuery ?: return null
+    return Uri.Builder()
+        .scheme("https")
+        .authority(host)
+        .encodedPath(uri.encodedPath)
+        .encodedQuery(query)
+        .build()
+        .toString()
